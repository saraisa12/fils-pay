# Shared, NON-secret service settings, loaded by docker-compose for every service.
# Secrets (SETTLEMENT_INTERNAL_TOKEN, WEBHOOK_SECRET_ENCRYPTION_KEY,
# ACQUIRER_CALLBACK_SIGNING_SECRET, POSTGRES_PASSWORD) are NOT stored here: set them in the
# environment of the box (see ops/README.md) and compose refuses to start without them.
NODE_ENV=production
COOKIE_SECURE=true
OTP_DEV_EXPOSE=false
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true
PG_POOL_MAX=20
MAX_INFLIGHT_PAYMENTS=40
SETTLEMENT_PG_POOL_MAX_CONNS=3
